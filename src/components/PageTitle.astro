---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageTags from './PageTags.astro';

// Tagging from the layout rather than from the pages keeps the chip row out of
// the content body, where it would sit inside the prose styles and have to be
// repeated in every file.
const { tags } = Astro.locals.starlightRoute.entry.data;
---

<Default />
{tags && <PageTags tags={tags} />}
