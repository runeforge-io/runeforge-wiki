---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { LinkButton } from '@astrojs/starlight/components';
import RuneforgeLogo from '../assets/runeforge-logo.svg';

// Drop-in hero artwork: any src/assets/hero-bg.{avif,jpg,jpeg,png,webp} is
// picked up and bled full-width behind the panel. Globbed rather than imported
// so the build still passes while no such file exists, in which case the
// backdrop falls back to its gradient layers alone.
const [heroBg] = Object.values(
  import.meta.glob<ImageMetadata>('../assets/hero-bg.{avif,jpg,jpeg,png,webp}', {
    eager: true,
    import: 'default',
  }),
);

// Starlight's skip link targets this id. It lives behind a package internal,
// so the value is restated here rather than imported.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

// Counted off the collection rather than written down, so the strip cannot
// drift from the content it describes. A topic is a directory under
// specific-guide/, which is why single-segment entries there are skipped.
const pages = (await getCollection('docs')).filter((page) => page.data.template !== 'splash');
const topics = new Set(
  pages.flatMap((page) => {
    const parts = page.id.split('/');
    return parts[0] === 'specific-guide' && parts.length > 2 ? [parts[1]] : [];
  }),
);

const stats = [
  { key: 'guides', label: 'Guides', value: pages.length },
  {
    key: 'tools',
    label: 'Tools',
    value: pages.filter((page) => page.id.startsWith('core-guides/tools/')).length,
  },
  { key: 'topics', label: 'Topics', value: topics.size },
];
---

<div class="rf-hero">
  <div class="rf-hero-backdrop" aria-hidden="true">
    {
      heroBg && (
        <Image
          src={heroBg}
          alt=""
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </div>

  <div class="rf-hero-panel">
    <RuneforgeLogo class="rf-hero-mark" aria-hidden="true" />
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {tagline && <p class="rf-hero-tagline" set:html={tagline} />}

    <button type="button" class="rf-hero-search" data-rf-hero-search>
      <span class="rf-hero-search-icon" aria-hidden="true"></span>
      Search the wiki
    </button>

    {
      actions.length > 0 && (
        <div class="rf-hero-actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }

    <ul class="rf-hero-stats">
      {
        stats.map((stat) => (
          <li class="rf-stat" data-icon={stat.key}>
            <span class="rf-stat-value">{stat.value}</span>
            <span>{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  // Forwards to Starlight's search dialog rather than shipping a second one;
  // the header holds the page's only <site-search>.
  document.querySelector('[data-rf-hero-search]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
  });
</script>

<style>
  .rf-hero {
    padding-block: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 3vw, 2rem);
  }

  /* Full-bleed backdrop, anchored to `.page` — which custom.css turns into the
     containing block on splash pages — so the artwork escapes the content
     column without 100vw scrollbar arithmetic. Nothing between here and `.page`
     may be positioned, which is why `.rf-hero` itself is not. */
  .rf-hero-backdrop {
    position: absolute;
    z-index: -1;
    inset-block-start: 0;
    inset-inline: 0;
    height: clamp(34rem, 100svh, 52rem);
    overflow: hidden;
  }

  .rf-hero-backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  /* Scrim: sinks the artwork behind the copy and lands it on the page colour.
     Carries the crimson glow on its own when no artwork is present. */
  .rf-hero-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60rem 26rem at 50% 0%,
        color-mix(in srgb, var(--rf-crimson) 20%, transparent),
        transparent 70%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--sl-color-black) 58%, transparent),
        color-mix(in srgb, var(--sl-color-black) 72%, transparent) 45%,
        var(--sl-color-black)
      );
  }

  .rf-hero-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 54rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
    /* Clips the crimson edge to the corner radius. */
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--rf-radius-lg);
    background-color: var(--rf-glass-hero-fill);
    -webkit-backdrop-filter: var(--rf-glass-hero-blur);
    backdrop-filter: var(--rf-glass-hero-blur);
    text-align: center;
  }

  .rf-hero-panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--rf-crimson) 50%, transparent);
  }

  .rf-hero-panel :global(svg.rf-hero-mark) {
    width: clamp(2.75rem, 7vw, 4rem);
    height: auto;
    fill: var(--rf-crimson);
    filter: var(--rf-mark-glow);
    animation: rf-mark-float 6s ease-in-out infinite;
  }

  @keyframes rf-mark-float {
    50% {
      transform: translateY(-0.375rem);
    }
  }

  /* The global block only clamps duration, which on an infinite animation
     leaves it running. */
  @media (prefers-reduced-motion: reduce) {
    .rf-hero-panel :global(svg.rf-hero-mark) {
      animation: none;
    }
  }

  .rf-hero-panel h1 {
    font-size: clamp(1.875rem, 5.5vw, 3.125rem);
    font-weight: var(--rf-weight-bold);
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .rf-hero-tagline {
    max-width: 34rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--sl-color-gray-2);
    text-wrap: balance;
  }

  /* A button, not an input: it opens Starlight's dialog, which owns the real
     field. The base rule carries the slow hover-out. */
  .rf-hero-search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: min(100%, 34rem);
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--rf-radius-md);
    background-color: color-mix(in srgb, var(--sl-color-black) 65%, transparent);
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-sm);
    text-align: start;
    cursor: pointer;
    transition:
      border-color var(--rf-dur-out) ease,
      color var(--rf-dur-out) ease;
  }

  .rf-hero-search:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-gray-2);
    transition-duration: var(--rf-dur-in);
    transition-timing-function: var(--rf-ease-snap);
  }

  .rf-hero-search-icon {
    flex-shrink: 0;
    width: 1.125em;
    height: 1.125em;
    background-color: currentcolor;
    -webkit-mask: url('@phosphor-icons/core/assets/bold/magnifying-glass-bold.svg') center / contain
      no-repeat;
    mask: url('@phosphor-icons/core/assets/bold/magnifying-glass-bold.svg') center / contain
      no-repeat;
  }

  .rf-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .rf-hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem 1.75rem;
    width: 100%;
    margin: 0;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--sl-color-hairline);
  }

  .rf-stat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .rf-stat::before {
    content: '';
    width: 1.125em;
    height: 1.125em;
    background-color: var(--sl-color-accent-high);
    -webkit-mask: var(--rf-stat-icon) center / contain no-repeat;
    mask: var(--rf-stat-icon) center / contain no-repeat;
  }

  .rf-stat[data-icon='guides'] {
    --rf-stat-icon: url('@phosphor-icons/core/assets/bold/book-open-bold.svg');
  }
  .rf-stat[data-icon='tools'] {
    --rf-stat-icon: url('@phosphor-icons/core/assets/bold/toolbox-bold.svg');
  }
  .rf-stat[data-icon='topics'] {
    --rf-stat-icon: url('@phosphor-icons/core/assets/bold/squares-four-bold.svg');
  }

  .rf-stat-value {
    font-weight: var(--rf-weight-bold);
    color: var(--sl-color-white);
  }
</style>
