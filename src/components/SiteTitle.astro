---
// Replaces Starlight's SiteTitle with the Runeforge app's header treatment:
// the logo mark in a crimson rounded box, followed by "Wiki". The full
// "Runeforge Wiki" name stays in page metadata (config.title) and for
// screen readers via the sr-only span.
import RuneforgeLogo from '../assets/runeforge-logo.svg';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<span class="logo-box"><RuneforgeLogo aria-hidden="true" /></span>
	<span class="title-text" translate="no"><span class="sr-only">Runeforge </span>Wiki</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.625rem;
		font-size: var(--sl-text-h4);
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.logo-box {
		display: flex;
		flex-shrink: 0;
		padding: 0.3rem;
		border-radius: 0.5rem;
		background-color: #ed0049; /* crimson-500 */
	}
	.logo-box :global(svg) {
		width: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y) - 0.85rem);
		height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y) - 0.85rem);
		fill: #e9f4fb; /* base-100 */
	}
	.title-text {
		overflow: hidden;
	}
</style>
